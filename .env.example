# ─────────────────────────────────────────────
#  COPY THIS FILE TO .env AND FILL IN YOUR KEYS
# ─────────────────────────────────────────────

# Claude AI (get from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Amazon SP-API ──────────────────────────────
AMAZON_CLIENT_ID=amzn1.application-oa2-client.xxxx
AMAZON_CLIENT_SECRET=your_client_secret_here
AMAZON_REFRESH_TOKEN=Atzr|your_refresh_token_here
AMAZON_SELLER_ID=your_seller_id_here
# Marketplace: US=ATVPDKIKX0DER | IN=A21TJRUUN4KGV | UK=A1F83G8C2ARO7P
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV

# ── Myntra Seller API ──────────────────────────
MYNTRA_API_KEY=your_myntra_api_key_here
MYNTRA_API_SECRET=your_myntra_api_secret_here
MYNTRA_SELLER_ID=your_myntra_seller_id_here

# ── Telegram Bot (for 24/7 alerts) ────────────
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal Telegram user ID (get from @userinfobot)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── App Settings ──────────────────────────────
DATABASE_URL=sqlite:///./seller_ai.db
LOG_LEVEL=INFO
DASHBOARD_PORT=8000
# How often agents run (in minutes)
ORDER_CHECK_INTERVAL=15
INVENTORY_CHECK_INTERVAL=60
PRICING_CHECK_INTERVAL=120
SUPPORT_CHECK_INTERVAL=10
ANALYTICS_REPORT_TIME=08:00
